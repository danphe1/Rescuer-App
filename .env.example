# Public project URL and publishable/anon browser key only.
# NEVER place a Supabase service-role/secret key in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Optional explicit function endpoints. When omitted, they are derived from VITE_SUPABASE_URL.
VITE_RESCUE_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/rescue-tracker-api
VITE_COMMAND_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/rescue-command-api
